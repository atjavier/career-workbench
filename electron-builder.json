{
  "appId": "com.adrian.career-workbench",
  "productName": "Career Workbench",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone"
    },
    {
      "from": "resume-template.tex",
      "to": "resume-template.tex"
    },
    {
      "from": "Resume.pdf",
      "to": "Resume.pdf"
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "category": "public.app-category.productivity",
    "minimumSystemVersion": "12.0.0",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
